rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} = { role: "owner" | "staff", accountId, venueId }
    // Created only by the server functions (sign-up, add staff). Old test logins may only have venueId.
    // You (the platform owner): admins/{uid} exists. Created by you in the console.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function venueData(venueId) {
      return get(/databases/$(database)/documents/venues/$(venueId)).data;
    }
    // Branch staff see their own branch; owners see every branch in their account.
    function staffOf(venueId) {
      return signedIn() && (
        me().get('venueId', '') == venueId
        || (me().get('role', '') == 'owner'
            && venueData(venueId).get('accountId', '') == me().get('accountId', 'none')));
    }
    function ownerOfAccount(accountId) {
      return signedIn() && me().get('role', '') == 'owner' && me().get('accountId', '') == accountId;
    }
    // Trial or paid period, plus 3 days of grace, and not paused by you. Old venues without an account always work.
    function accountOk(accountId) {
      let a = get(/databases/$(database)/documents/accounts/$(accountId)).data;
      return request.time < a.activeUntil + duration.value(3, 'd') && !a.get('suspended', false);
    }
    function canTakeOrders(venueId) {
      let v = venueData(venueId);
      return !('accountId' in v) || accountOk(v.accountId);
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validChannel() {
      return request.resource.data.channel in ['push', 'page']
        && (!('pushToken' in request.resource.data)
            || (request.resource.data.pushToken is string && request.resource.data.pushToken.size() < 400));
    }

    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Payment records you enter in the admin panel.
    match /payments/{paymentId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /accounts/{accountId} {
      allow get: if isAdmin() || (signedIn() && me().get('accountId', '') == accountId);
      allow list: if isAdmin();
      allow create, delete: if false;
      // Owners can change the brand. Plan, dates, limits and pausing are changed only by you (admin panel).
      allow update: if (ownerOfAccount(accountId) && changedOnly(['name', 'initial', 'color']))
        || (isAdmin() && changedOnly(['plan', 'activeUntil', 'maxBranches', 'suspended', 'adminNote', 'lastPaymentAt']));
    }

    match /venues/{venueId} {
      // Customers need the name, colour and pickup point. A venue can't be listed, only opened by its ID.
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if false;
      allow update: if staffOf(venueId)
        && changedOnly(['name', 'initial', 'color', 'counter', 'note', 'reviewUrl', 'numberMode', 'branch']);

      match /meta/{docId} {
        allow read, write: if staffOf(venueId);
      }

      match /tickets/{ticketId} {
        // A customer can open their own ticket by its random ID, but can't list the others.
        allow get: if true;
        allow list: if staffOf(venueId) || isAdmin();

        allow create: if staffOf(venueId)
          && canTakeOrders(venueId)
          && request.resource.data.status == 'new'
          && !('pushToken' in request.resource.data);

        allow update: if staffOf(venueId)
          // customer scans and turns on alerts
          || (resource.data.status == 'new'
              && request.resource.data.status == 'waiting'
              && changedOnly(['status', 'linkedAt', 'channel', 'pushToken'])
              && request.resource.data.linkedAt == request.time
              && validChannel())
          // customer turns notifications on later
          || (resource.data.status in ['waiting', 'ready']
              && changedOnly(['channel', 'pushToken'])
              && validChannel())
          // customer taps "On my way"
          || (resource.data.status == 'ready'
              && changedOnly(['seenAt'])
              && request.resource.data.seenAt == request.time)
          // customer rates the visit and leaves a private note
          || (resource.data.status == 'collected'
              && changedOnly(['rating', 'feedback'])
              && (!('rating' in request.resource.data)
                  || (request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5))
              && (!('feedback' in request.resource.data)
                  || (request.resource.data.feedback is string
                      && request.resource.data.feedback.size() <= 500)));

        allow delete: if false;
      }
    }
  }
}
